{
  "name": "precisely-api-e2e-tests",
  "version": "1.0.0",
  "description": "E2E API tests for Precisely APIs with Playwright",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:security": "playwright test --grep @security",
    "test:smoke": "playwright test --grep @smoke",
    "allure:generate": "allure generate allure-results -o allure-report"
  },
  "dependencies": {
    "@playwright/test": "^1.40.0",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "joi": "^17.11.0",
    "allure-playwright": "^2.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
