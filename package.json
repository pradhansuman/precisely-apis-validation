{
  "name": "precisely-apis-e2e-tests",
  "version": "1.0.0",
  "description": "Principal-grade E2E API tests for Precisely APIs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:auth": "playwright test --grep '@auth'",
    "test:geocode": "playwright test --grep '@geocode'",
    "test:smoke": "playwright test --grep '@smoke'"
  },
  "keywords": [
    "playwright",
    "api-testing",
    "e2e",
    "precisely-apis"
  ],
  "author": "Principal API Test Architect",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}
